{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "check-imports": "bun run ../../scripts/check-imports.ts",
    "clean": "rm -rf .expo .turbo node_modules",
    "rnr-add": "bunx @react-native-reusables/cli@latest add",
    "build:ios": "eas build --platform ios --profile development --local --output dist/scaffold-dev.tar.gz",
    "build:ios:simulator": "eas build --platform ios --profile development-simulator --local --output dist/scaffold-simulator.tar.gz",
    "build:ios:production": "eas build --platform ios --profile production --local --output dist/scaffold.ipa",
    "build:android": "eas build --platform android --profile development --local --output dist/scaffold-dev.apk",
    "build:android:production": "eas build --platform android --profile production --local --output dist/scaffold.aab",
    "build:production": "eas build --platform all --profile production && eas submit --platform all",
    "submit:ios": "eas submit --platform ios --no-wait",
    "submit:android": "eas submit --platform android --no-wait"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@packages/backend": "workspace:*",
    "@packages/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/elements": "^2.9.29",
    "@react-navigation/native": "^7.3.7",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.1",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "lucide-react-native": "^1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "^3.6.0",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@packages/eslint-config": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3"
  }
}
