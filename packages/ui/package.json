{
  "name": "@packages/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/components/button.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "ui-add": "bunx shadcn@latest add && prettier src --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@packages/eslint-config": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.4",
    "prettier": "^3.9.4",
    "react": "^19.2.3",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "tailwindcss": ">=4.0.0"
  }
}
