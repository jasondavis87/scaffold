{
  "name": "@packages/monorepo",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "tooling/*"],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "turbo typecheck lint format check-imports && bun run check-tokens",
    "check:ci": "turbo typecheck lint format:check check-imports && bun run check-tokens",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check-imports": "turbo check-imports",
    "check-tokens": "bun run scripts/check-token-sync.ts",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "ios": "cd apps/mobile && bun run ios",
    "android": "cd apps/mobile && bun run android",
    "test": "turbo test",
    "convex:ai:status": "cd packages/backend && bunx convex ai-files status",
    "convex:ai:update": "cd packages/backend && bunx convex ai-files update",
    "ui-add": "turbo run ui-add",
    "v0-bundle": "bash scripts/create-v0-bundle.sh"
  },
  "prettier": "@packages/prettier-config",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@packages/prettier-config": "workspace:*",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.10.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "typescript": "6.0.3",
    "convex": "1.42.1",
    "zod": "4.4.3",
    "eslint": "9.39.4"
  }
}
